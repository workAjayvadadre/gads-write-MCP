# gads-write-mcp environment
# Copy to .env and fill in. NEVER commit .env.

# --- Kill switch -------------------------------------------------------
# false = server is read-only, every write is refused at the guard.
# Default is false. You must deliberately turn writes on.
GADS_WRITE_ENABLED=false

# --- Deployment --------------------------------------------------------
GADS_ENV=production
GADS_HOST=127.0.0.1
# The read-only google-ads-mcp already uses 8000 on this box. Do not collide.
GADS_PORT=8081
# Must exactly match the origin registered in the Google OAuth client.
GADS_BASE_URL=https://adswrite.indiraivf.in

# --- Google OAuth (per-user login) -------------------------------------
GADS_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GADS_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# Stable random string. Without it, every restart invalidates every user's
# session and everyone has to re-authorise. Generate once:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
GADS_JWT_SIGNING_KEY=

# --- Google Ads --------------------------------------------------------
# Not used until Phase 3, but validated at boot so a missing value fails
# on deploy rather than on someone's first budget change.
GADS_DEVELOPER_TOKEN=
# Your MCC / manager account, digits only, no dashes.
GADS_LOGIN_CUSTOMER_ID=

# --- Tuning (optional; sane defaults, shown here so they are discoverable) --
# How long a resolved Google Ads tier is reused before being looked up again.
# This is the window in which someone removed from Google Ads still appears
# to have their old tier HERE. It is not a security boundary - every Google
# Ads call uses the user's own OAuth token, so Google refuses them
# immediately regardless. It only affects which tools show in the menu.
# 0 disables caching; anything above 900 is refused at boot. Default 60.
GADS_TIER_CACHE_SECONDS=60

# How many days of audit files to keep. The log rotates and prunes ITSELF,
# in-process, so the server runs unattended - do NOT add a logrotate rule.
# The daily spend ceiling is rebuilt from these files, so an external tool
# that truncates or moves them would silently reset every user's allowance.
# Minimum 1. Default 400 (a year plus a margin).
GADS_AUDIT_RETENTION_DAYS=400

# --- Paths -------------------------------------------------------------
GADS_POLICY_PATH=config/policy.yaml
GADS_ROLES_PATH=config/roles.yaml
# Records are written to dated files beside this path, e.g.
# logs/audit-2026-09-02.jsonl. An existing single audit.jsonl is still read.
GADS_AUDIT_LOG_PATH=logs/audit.jsonl
